    },
    "puppy": {
      "pet": "Щенок Тяпа",
      "voice": "Восторженный и ласковый. Простые слова, много радости, «Ура!» и «Гав!»"
    },
    "dragon": {
      "pet": "Дракончик Бумба",
      "voice": "Мечтатель. Говорит о мечтах, полётах и приключениях. Копилка для него — сокровищница мечты."
    }
